{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "anissia-web",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },

  "build": {
    "command": "npm run build",
    "watch_dir": ["src", "public", "index.html", "vite.config.ts"]
  },

  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
