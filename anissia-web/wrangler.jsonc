{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "anissia-web",
  "compatibility_date": "2026-05-03",
  "observability": {
    "enabled": true
  },

  "assets": {
    "directory": "dist",
    "not_found_handling": "none"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
