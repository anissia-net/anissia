@import url('https://fonts.googleapis.com/css2?family=Gaegu:wght@300;400;700&family=Hachi+Maru+Pop&family=Noto+Sans+JP:wght@100..900&family=Noto+Sans+KR:wght@100..900&display=swap');
@import "./tailwind.pcss";

@layer base {
    :root {
        --font-family-sans: "Noto Sans KR", "Noto Sans JP", -apple-system, BlinkMacSystemFont, "Malgun Gothic", "Dotum", sans-serif;
        --font-family-cursive: "Gaegu", "Hachi Maru Pop", cursive;
    }

    :lang(ja) {
        --font-family-sans: "Noto Sans JP", -apple-system, BlinkMacSystemFont, sans-serif;
        --font-family-cursive: "Hachi Maru Pop", "Gaegu", cursive;
    }

    html.light {
        color-scheme: light;

        --as-canvas: #f3f5f9;
        --as-canvas-2: #e9edf4;
        --as-surface: rgba(255, 255, 255, .84);
        --as-surface-2: rgba(255, 255, 255, .72);
        --as-muted: rgba(30, 50, 90, .05);
        --as-line: rgba(20, 35, 65, .09);
        --as-line-2: rgba(20, 35, 65, .17);
        --as-ink: #121a2b;
        --as-ink-2: #3c475b;
        --as-ink-3: #687387;
        --as-brand: #2c4c8c;
        --as-brand-2: #1f3a70;
        --as-brand-soft: rgba(44, 76, 140, .08);
        --as-danger: #c23b3b;
        --as-success: #217a5c;

        --as-glass-line: rgba(20, 35, 65, .08);
        --as-glass-line-2: rgba(20, 35, 65, .16);
        --as-glass-strong: #ffffff;
        --as-glass-inset: inset 0 1px 0 rgba(255, 255, 255, .95);
        --as-blur: 14px;

        --as-bg-1: rgba(120, 150, 205, .16);
        --as-bg-2: rgba(170, 190, 220, .14);
        --as-bg-3: rgba(140, 160, 205, .10);

        --as-gradient: linear-gradient(120deg, #5f7fbd 0%, #2c4c8c 55%, #1a2f5a 100%);
        --as-on-brand: #ffffff;

        --as-shadow-1: 0 1px 0 rgba(20, 35, 65, .03), 0 4px 14px -10px rgba(20, 35, 65, .16);
        --as-shadow-2: 0 10px 30px -16px rgba(20, 35, 65, .20);
        --as-shadow-3: 0 24px 60px -22px rgba(20, 35, 65, .30);
        --as-shadow-brand: 0 8px 22px -10px rgba(44, 76, 140, .55);
        --as-ring: 0 0 0 3px rgba(44, 76, 140, .15);
        --as-wordmark-gradient: linear-gradient(120deg, #131d33 0%, #2c4c8c 55%, #6a8cc9 100%);

        --as-edge: linear-gradient(var(--edge-angle, 155deg), rgba(70, 105, 180, .26) 0%, rgba(20, 35, 65, .12) 30%, rgba(20, 35, 65, .13) 68%, rgba(20, 35, 65, .19) 100%);
        --as-edge-glow: rgba(44, 76, 140, .85);

        --as-choice-bg: #ffffff;
        --as-choice-shadow: 0 0 0 1px rgba(20, 35, 65, .10), 0 2px 6px -2px rgba(20, 35, 65, .18);
        --as-choice-ink: var(--as-brand);
    }

    html.dark {
        color-scheme: dark;

        --as-canvas: #0b0b10;
        --as-canvas-2: #131318;
        --as-surface: rgba(29, 29, 38, .55);
        --as-surface-2: rgba(168, 165, 190, .06);
        --as-muted: rgba(168, 165, 190, .08);
        --as-line: rgba(255, 255, 255, .07);
        --as-line-2: rgba(255, 255, 255, .15);
        --as-ink: #eceaf2;
        --as-ink-2: #bcbac9;
        --as-ink-3: #8f8c9e;
        --as-brand: #e3aa9a;
        --as-brand-2: #f4cbbe;
        --as-brand-soft: rgba(227, 170, 154, .12);
        --as-danger: #f47272;
        --as-success: #3ecf9a;

        --as-glass-line: rgba(255, 255, 255, .09);
        --as-glass-line-2: rgba(255, 255, 255, .18);
        --as-glass-strong: rgba(40, 40, 52, .85);
        --as-glass-inset: inset 0 1px 0 rgba(255, 255, 255, .06);
        --as-blur: 18px;

        --as-bg-1: rgba(225, 145, 125, .10);
        --as-bg-2: rgba(150, 115, 120, .06);
        --as-bg-3: rgba(195, 120, 130, .06);

        --as-gradient: linear-gradient(120deg, #f7d0c2 0%, #e3aa9a 55%, #c28270 100%);
        --as-on-brand: #181110;

        --as-shadow-1: 0 1px 2px rgba(0, 0, 0, .25);
        --as-shadow-2: 0 10px 32px -14px rgba(0, 0, 0, .60);
        --as-shadow-3: 0 28px 70px -24px rgba(0, 0, 0, .80);
        --as-shadow-brand: 0 8px 24px -10px rgba(220, 150, 130, .35);
        --as-ring: 0 0 0 3px rgba(227, 170, 154, .18);
        --as-title-rule: #c9b3ab;

        --as-edge: linear-gradient(var(--edge-angle, 155deg), rgba(255, 255, 255, .26) 0%, rgba(255, 255, 255, .07) 28%, rgba(255, 255, 255, .05) 66%, rgba(227, 170, 154, .22) 100%);
        --as-edge-glow: rgba(247, 208, 194, .95);

        --as-choice-bg: rgba(227, 170, 154, .17);
        --as-choice-shadow: inset 0 0 0 1px rgba(227, 170, 154, .42), 0 2px 8px -3px rgba(0, 0, 0, .5);
        --as-choice-ink: #f6d3c7;
    }

    html {
        overflow-y: scroll;
        -webkit-text-size-adjust: 100%;
    }

    body {
        font-feature-settings: "cv02", "cv03", "cv04", "cv11";
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;

        background:
            radial-gradient(52rem 34rem at 12% -10%, var(--as-bg-1), transparent 62%),
            radial-gradient(44rem 30rem at 92% 6%, var(--as-bg-2), transparent 64%),
            radial-gradient(60rem 40rem at 50% 115%, var(--as-bg-3), transparent 62%),
            var(--as-canvas);
        background-attachment: fixed;
        color: var(--as-ink);
    }
}

::-webkit-scrollbar { width: 10px; height: 10px }
::-webkit-scrollbar-corner { background: transparent }

html.light {
    ::-webkit-scrollbar-track { background-color: transparent }
    ::-webkit-scrollbar-thumb { background-color: rgba(20, 35, 65, .18); border: 3px solid transparent; background-clip: content-box; border-radius: 999px }
    ::-webkit-scrollbar-thumb:hover { background-color: rgba(20, 35, 65, .34) }
    ::selection { background: rgba(44, 76, 140, .16); color: #121a2b }
}

html.dark {
    ::-webkit-scrollbar-track { background-color: transparent }
    ::-webkit-scrollbar-thumb { background-color: rgba(236, 234, 242, .16); border: 3px solid transparent; background-clip: content-box; border-radius: 999px }
    ::-webkit-scrollbar-thumb:hover { background-color: rgba(236, 234, 242, .30) }
    ::selection { background: rgba(227, 170, 154, .24); color: #eceaf2 }
}

html:has(#sc2009, #sc2015, #sc2024) {
    body { background: none }

    &.light {
        background: #fff;
        ::-webkit-scrollbar { width: 8px; height: 8px }
        ::-webkit-scrollbar-track { background-color: #fafafa }
        ::-webkit-scrollbar-thumb { background-color: rgba(0, 0, 0, 0.2); border: 0; border-radius: 0; background-clip: border-box }
        ::-webkit-scrollbar-thumb:hover { background-color: rgba(0, 0, 0, 0.4) }
        ::selection { background: #eee; color: #007cd8 }
    }
    &.dark {
        background: #000;
        ::-webkit-scrollbar { width: 8px; height: 8px }
        ::-webkit-scrollbar-track { background-color: #222 }
        ::-webkit-scrollbar-thumb { background-color: rgba(255, 255, 255, 0.2); border: 0; border-radius: 0; background-clip: border-box }
        ::-webkit-scrollbar-thumb:hover { background-color: rgba(255, 255, 255, 0.4) }
        ::selection { background: #1e1e1eb0; color: #a7975c }
    }
}

.as-app {
    color: var(--as-ink);

    overflow-x: clip;

    :where(.grid, .flex) > * {
        min-width: 0;
    }

    .container {
        width: 100%;
        max-width: 1200px;
        margin-inline: auto;
    }
}

/*
 * 좁은 화면에서는 가로 여백을 반으로 줄인다 — 400px 도 안 되는 폭에서 양쪽을 16px 씩 깎으면
 * 글이 앉을 자리가 그만큼 줄고, 편집기에서는 그 손실이 그대로 쓰는 자리의 손실이 된다.
 */
.as-container, .as-page {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 0.5rem;
}

@media (min-width: 480px) {
    .as-container, .as-page {
        padding-inline: 1rem;
    }
}

.as-page {
    padding-top: 2rem;
    padding-bottom: 1rem;
}

@media (min-width: 768px) {
    .as-container, .as-page {
        padding-inline: var(--spacing-gutter);
    }
    .as-page {
        padding-top: 2.5rem;
    }
}

.as-page-narrow {
    @apply w-full mx-auto;
    max-width: 480px;
    padding-inline: 1rem;
}

.as-sections > * + * {
    margin-top: var(--spacing-section);
}

.as-wordmark {
    background: var(--as-wordmark-gradient, var(--as-gradient));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: .08em;
}

html.dark .as-wordmark {
    --as-wordmark-gradient: linear-gradient(120deg, #fcf0eb 0%, #ebc6b8 45%, #b28d80 100%);
}

.as-section-title {
    @apply relative inline-flex items-center gap-2.5 font-bold;
    font-size: 1.125rem;
    line-height: 1.5;
    letter-spacing: -.015em;
    padding-bottom: .4rem;
    color: var(--as-ink);
    box-shadow: inset 0 -2px 0 var(--as-title-rule, var(--as-ink));
}

/* 섹션 머리 — 제목 밑줄이 줄 전체의 가는 선 위에 선다. */
.as-section-head {
    @apply flex items-end justify-between gap-4 mb-3;
    box-shadow: inset 0 -1px 0 var(--as-line-2);
}

.as-page-title {
    @apply font-extrabold;
    font-size: 2rem;
    line-height: 1.25;
    letter-spacing: -.035em;
    color: var(--as-ink);
}

.as-sub-title {
    @apply block font-semibold uppercase;
    font-size: .6875rem;
    letter-spacing: .2em;
    color: var(--as-ink-3);
}

.as-desc {
    @apply text-sm;
    color: var(--as-ink-2);
}

.as-meta {
    @apply text-xs tabular-nums;
    color: var(--as-ink-3);
}

.as-page-head {
    @apply mb-6;
    > .as-desc { @apply mt-2 }
}

.as-empty {
    @apply text-center py-24 text-lg;
    color: var(--as-ink-3);
}

.as-divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--as-line) 12%, var(--as-line) 88%, transparent);
}

.as-a-color {
    a {
        color: var(--as-brand);
        transition: color .18s ease;
        &:hover { color: var(--as-brand-2) }
    }
}

.as-link {
    color: var(--as-brand);
    transition: color .18s ease;
    &:hover { color: var(--as-brand-2) }
}

.as-box {
    background: var(--as-surface);
    -webkit-backdrop-filter: blur(var(--as-blur)) saturate(160%);
    backdrop-filter: blur(var(--as-blur)) saturate(160%);
    border-radius: var(--radius-card);
    box-shadow: var(--as-shadow-1);
    transition: box-shadow .2s ease, background-color .2s ease;
}

/*
 * 글 한 편이 한 장으로 선다 — 작성자 줄이 머리, 본문이 몸이다.
 * 둘을 따로 띄우면 한 편이 두 덩이로 갈려 보여서, 테두리와 그림자는 바깥 한 겹에만 건다.
 *
 * 바탕은 두 테마 모두 **불투명**하다 — 유리로 두면 뒤의 그러데이션이 글자 밑으로 비쳐
 * 긴 글을 읽기 힘들다. 대신 바탕보다 한 단 올라온 색을 써서 떠 있는 느낌을 낸다.
 * 불투명하니 blur 는 보이지도 않아 걷어냈다.
 */
.as-post {
    background: var(--as-surface);
    border-radius: var(--radius-card);
    box-shadow: var(--as-shadow-1);
}

/*
 * 글 한 편의 안쪽 여백. 읽는 자리(`NoteView`)와 고쳐 쓰는 자리(`PostEditor`)가 이 값 하나를
 * 같이 본다 — "수정" 을 눌렀을 때 글이 옆으로 밀리면 같은 글을 고치는 것처럼 보이지 않는다.
 * 나비 코어가 `.nabi-content` 에 두르던 `12px 14px` 는 `nabi.pcss` 에서 걷어냈고, 이제 여백은
 * 글이 앉은 종이가 혼자 두른다.
 */
:root {
    --as-post-pad-x: 1rem;
    --as-post-pad-y: 0.875rem;
    --as-post-head-pad: 0.625rem;
}

@media (min-width: 640px) {
    :root {
        --as-post-pad-x: 1.5rem;
        --as-post-pad-y: 1.25rem;
        --as-post-head-pad: 0.75rem;
    }
}

/*
 * 머리줄(작성자·날짜, 글쓰기에서는 주제)은 본문과 **다른 장**이다 — 가르는 선 대신 사이의 빈
 * 자리가 둘을 나눈다. 종이의 라운드(20px)는 이 낮은 줄에는 너무 둥글어 알약처럼 보이므로
 * 조작부의 라운드를 쓴다.
 */
.as-post-head {
    padding: var(--as-post-head-pad);
    border-radius: var(--radius-ctl);
}

/* 본문도 같은 라운드를 쓴다 — 짧은 글 한 줄이 20px 라운드를 만나면 알약이 된다. */
.as-post-body {
    padding: var(--as-post-pad-y) var(--as-post-pad-x);
    border-radius: var(--radius-ctl);
}

/*
 * 고쳐 쓰는 종이는 여백을 두르지 않는다 — 편집기가 종이를 꽉 채운다.
 * 안쪽 여백은 쓰는 자리가 스스로 두르므로(`nabi.pcss` 의 `.nabi .nabi-content`) 글이 서는 자리는
 * 읽는 화면과 같다. 달라지는 것은 **붙는 단추 줄**뿐 — 제 바탕으로 종이 폭을 그대로 덮는다.
 *
 * `overflow: clip` 으로 모서리를 자른다. `hidden` 이 아닌 까닭: `hidden` 은 스크롤 상자를 만들어
 * 안의 `position: sticky` 가 화면이 아니라 그 상자를 기준으로 잡히고, 그러면 스크롤이 없는 상자라
 * 단추 줄이 아예 안 붙는다. `clip` 은 상자를 만들지 않아 붙는 동작이 그대로 산다.
 */
.as-post-editor {
    border-radius: var(--radius-ctl);
    overflow: clip;
}

.as-post-editor-actions {
    padding: 0 var(--as-post-pad-x) var(--as-post-pad-y);
}

/*
 * 머리줄에 앉는 입력칸 — 종이가 이미 테두리를 두르고 있으니 제 테두리는 벗는다.
 * 대신 초점이 왔다는 말은 종이가 대신한다(`.as-post-head:has(input:focus)`).
 */
.as-input-bare {
    @apply block w-full bg-transparent border-0 p-0;
    color: var(--as-ink);
    &::placeholder { color: var(--as-ink-3) }
    &:focus, &:focus-visible { outline: none }
}

.as-post-head:has(.as-input-bare:focus) {
    --as-edge: linear-gradient(var(--as-brand), var(--as-brand));
    box-shadow: var(--as-ring);
}

/* 라이트는 흰 종이. */
html.light .as-post {
    background: #ffffff;
}

/* 어둠에서 흰 종이는 눈을 찌른다 — 바탕(`--as-canvas`)보다 한 단 밝은 면으로 같은 높이를 낸다. */
html.dark .as-post {
    background: var(--as-canvas-2);
}

.as-card {
    background: var(--as-surface);
    -webkit-backdrop-filter: blur(var(--as-blur)) saturate(160%);
    backdrop-filter: blur(var(--as-blur)) saturate(160%);
    border-radius: var(--radius-card);
    box-shadow: var(--as-shadow-1);
    transition: transform .22s var(--ease-out-quint), box-shadow .22s ease, background-color .2s ease;
    &:hover {
        transform: translateY(-1px);
        background: var(--as-glass-strong);
        box-shadow: var(--as-shadow-2);
    }
}

.as-glass {
    background: var(--as-surface);
    -webkit-backdrop-filter: blur(var(--as-blur)) saturate(160%);
    backdrop-filter: blur(var(--as-blur)) saturate(160%);
    box-shadow: var(--as-shadow-1);
}

.as-table {
    @apply w-full text-sm text-left;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--as-surface);
    -webkit-backdrop-filter: blur(var(--as-blur)) saturate(160%);
    backdrop-filter: blur(var(--as-blur)) saturate(160%);
    border-radius: var(--radius-card);
    box-shadow: var(--as-shadow-1);
    overflow: hidden;

    th {
        @apply px-5 py-3.5 font-semibold align-top;
        color: var(--as-ink);
        border-bottom: 1px solid var(--as-line);
    }

    td {
        @apply px-5 py-3.5 align-top;
        color: var(--as-ink-2);
        border-bottom: 1px solid var(--as-line);
    }

    thead th {
        @apply text-xs uppercase font-semibold;
        letter-spacing: .06em;
        background: var(--as-muted);
        color: var(--as-ink-3);
    }

    tbody tr:last-child > * { border-bottom: 0 }
}

.as-table-kv {
    tbody th {
        @apply w-[26%] min-w-[96px] text-xs font-semibold uppercase;
        letter-spacing: .06em;
        background: var(--as-muted);
        color: var(--as-ink-3);
    }
}

a.as-row {
    transition: translate .22s var(--ease-out-quint);
    &:hover { translate: 3px 0 }
}

.as-input-none {
    @apply outline-hidden resize-none border-none bg-transparent
}

.as-input-text {
    @apply block w-full text-sm resize-none;
    border-radius: var(--radius-ctl);
    background: var(--as-surface-2);
    border: 1px solid var(--as-line);
    color: var(--as-ink);
    transition: border-color .18s ease, box-shadow .18s ease, background-color .18s ease;
    &::placeholder { color: var(--as-ink-3) }
    &:hover { border-color: var(--as-line-2) }
    &:focus, &:focus-visible {
        outline: none;
        background: var(--as-glass-strong);
        border-color: var(--as-brand);
        box-shadow: var(--as-ring);
    }
}

.as-input-btn {
    @apply inline-block shrink-0 whitespace-nowrap text-center text-sm font-medium cursor-pointer select-none;
    border-radius: var(--radius-ctl);
    padding-left: 1rem;
    padding-right: 1rem;
    background: var(--as-surface);
    border: 1px solid var(--as-glass-line);
    color: var(--as-ink);
    box-shadow: var(--as-glass-inset);
    transition: transform .12s ease, border-color .18s ease, box-shadow .18s ease, background-color .18s ease, color .18s ease;
    &:hover {
        background: var(--as-glass-strong);
        border-color: var(--as-glass-line-2);
        color: var(--as-brand);
    }
    &:active { transform: translateY(1px) }
}

.as-btn-primary {
    @apply inline-block shrink-0 whitespace-nowrap text-center text-sm font-semibold cursor-pointer select-none;
    border-radius: var(--radius-ctl);
    padding-left: 1rem;
    padding-right: 1rem;
    background: var(--as-gradient);
    border: 1px solid transparent;
    color: var(--as-on-brand);
    box-shadow: var(--as-shadow-brand);
    transition: transform .12s ease, box-shadow .18s ease, filter .18s ease;
    &:hover { filter: brightness(1.06) saturate(1.05) }
    &:active { transform: translateY(1px); box-shadow: none }
}

.as-switch {
    @apply relative inline-flex items-center cursor-pointer select-none;
    > input { @apply sr-only }
    > .as-switch-track {
        @apply w-[40px] h-[22px] rounded-full transition-colors duration-200;
        background: var(--as-line-2);
        &::after {
            content: "";
            @apply absolute top-[3px] left-[3px] h-4 w-4 rounded-full bg-white transition-transform duration-200;
            box-shadow: 0 1px 3px rgba(0, 0, 0, .3);
        }
    }
    > input:checked + .as-switch-track {
        background: var(--as-brand);
        &::after { transform: translateX(18px) }
    }
    > input:focus-visible + .as-switch-track { box-shadow: var(--as-ring) }
}

.as-range {
    @apply w-full appearance-none cursor-pointer bg-transparent;
    height: 20px;
    &::-webkit-slider-runnable-track {
        height: 6px;
        border-radius: 999px;
        background: var(--as-muted);
        border: 1px solid var(--as-line);
    }
    &::-webkit-slider-thumb {
        appearance: none;
        margin-top: -6px;
        height: 16px;
        width: 16px;
        border-radius: 999px;
        background: var(--as-glass-strong);
        border: 2px solid var(--as-brand);
        box-shadow: var(--as-shadow-1);
        transition: transform .12s ease;
    }
    &::-webkit-slider-thumb:hover { transform: scale(1.12) }
    &::-moz-range-track {
        height: 6px;
        border-radius: 999px;
        background: var(--as-muted);
        border: 1px solid var(--as-line);
    }
    &::-moz-range-thumb {
        height: 14px;
        width: 14px;
        border-radius: 999px;
        background: var(--as-glass-strong);
        border: 2px solid var(--as-brand);
    }
}

.as-segment {
    @apply flex p-1 gap-1;
    border-radius: var(--radius-ctl);
    background: var(--as-muted);
    > button, > a, > label {
        @apply flex-1 text-center text-sm font-medium py-2 px-3 cursor-pointer select-none whitespace-nowrap transition-all duration-200;
        border-radius: calc(var(--radius-ctl) - 2px);
        color: var(--as-ink-2);
        &:hover { color: var(--as-ink) }
        &.is-on {
            background: var(--as-glass-strong);
            color: var(--as-ink);
            box-shadow: var(--as-glass-inset), var(--as-shadow-1);
        }
    }
}

/* 칸 폭이 글자만큼인 인라인 묶음 — 넘치면 줄을 바꾼다. */
.as-segment-inline {
    @apply inline-flex flex-wrap p-[3px] gap-0.5;
    max-width: 100%;
    > button, > a, > label {
        @apply flex-none text-xs py-1.5 px-3;
    }
}

/*
 * `v-choice` — 고른 칸 뒤의 판 하나가 미끄러져 옮겨 간다.
 * 칸 자체의 바탕은 걷고, 판(::before)이 고른 칸의 자리·크기(--choice-*)를 따라간다.
 */
.as-choice {
    position: relative;
    isolation: isolate;
    --choice-ease: cubic-bezier(.22, .8, .25, 1);
    --choice-duration: 380ms;

    &::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        z-index: 0;
        width: var(--choice-w, 0);
        height: var(--choice-h, 0);
        translate: var(--choice-x, 0) var(--choice-y, 0);
        border-radius: calc(var(--radius-ctl) - 2px);
        background: var(--as-choice-bg);
        box-shadow: var(--as-choice-shadow);
        opacity: 0;
        pointer-events: none;
        transition:
            translate var(--choice-duration) var(--choice-ease),
            width var(--choice-duration) var(--choice-ease),
            height var(--choice-duration) var(--choice-ease),
            opacity .2s ease;
    }

    &.has-choice::before { opacity: 1 }
    &:not([data-choice-ready])::before { transition: none }

    > * { position: relative; z-index: 1 }

    &.as-segment > .is-on {
        background: transparent;
        box-shadow: none;
        color: var(--as-choice-ink);
        font-weight: 600;
    }
}

.as-tag, .as-tag-xs {
    @apply inline-block text-xs font-medium leading-none;
    border-radius: 4px;
    background: transparent;
    border: 1px solid var(--as-line-2);
    color: var(--as-ink-2);
    transition: background-color .18s ease, border-color .18s ease, color .18s ease;
    &:hover {
        background: var(--as-brand-soft);
        border-color: color-mix(in oklab, var(--as-brand) 35%, transparent);
        color: var(--as-brand);
    }
    a { color: inherit }
}

.as-tag-xs {
    @apply px-2.5 py-[6px]
}

.as-tag {
    @apply px-3 py-[7px]
}

.as-toast-host {
    position: fixed;
    top: 1rem;
    left: 50%;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .5rem;
    width: max-content;
    max-width: calc(100vw - 2rem);
    transform: translateX(-50%);
    pointer-events: none;
}

.as-toast {
    @apply flex items-start gap-2.5 text-sm font-medium cursor-pointer select-none;
    pointer-events: auto;
    max-width: 26rem;
    padding: .6875rem 1rem;
    border-radius: var(--radius-ctl);
    background: var(--as-glass-strong);
    -webkit-backdrop-filter: blur(var(--as-blur)) saturate(160%);
    backdrop-filter: blur(var(--as-blur)) saturate(160%);
    border: 1px solid var(--as-line-2);
    color: var(--as-ink);
    box-shadow: var(--as-glass-inset), var(--as-shadow-3);
    animation: as-toast-in .28s var(--ease-out-quint) both;

    &.is-leave { animation: as-toast-out .18s ease both }
}

.as-toast-icon {
    @apply shrink-0 text-[15px];
    line-height: var(--text-sm--line-height);
}

.as-toast-success .as-toast-icon { color: var(--as-success) }
.as-toast-error .as-toast-icon { color: var(--as-danger) }

.as-toast-text {
    white-space: pre-line;
    overflow-wrap: anywhere;
}

@keyframes as-toast-in {
    from { opacity: 0; transform: translateY(-8px) scale(.98) }
}

@keyframes as-toast-out {
    to { opacity: 0; transform: translateY(-6px) scale(.98) }
}

/*
 * 상자 테두리 — 단색 실선 대신 1px 마스크 고리 두 겹.
 * ::before 는 왼쪽 위에서 빛을 받은 듯 색이 갈리는 선, ::after 는 커서 자리(--mx/--my, edgeLight.ts)에서 번지는 빛.
 */
:is(.as-box, .as-card, .as-table, .as-post, .as-glass) {
    position: relative;
}

:is(.as-box, .as-card, .as-table, .as-post, .as-header-bar, .as-menu-panel, .as-glass) {
    &::before, &::after {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        padding: 1px;
        border-radius: inherit;
        -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
    }
    &::before { background: var(--as-edge) }
    &::after {
        background: radial-gradient(var(--edge-light-size, 160px) circle at var(--mx, 50%) var(--my, 0), var(--as-edge-glow), transparent 70%);
        opacity: 0;
        transition: opacity .35s ease;
    }
    &:hover::after { opacity: 1 }
}

/* 고쳐 쓰는 종이 — 붙는 단추 줄(--nabi-z-sticky: 31)이 테두리를 덮지 않게 고리를 그 위로. */
.as-post-editor::before, .as-post-editor::after { z-index: 32 }

/* 마우스가 없는 기기 — 빛은 늘 켜 두고 스크롤로 움직인다(edgeLight.ts). */
html.as-edge-scroll :is(.as-box, .as-card, .as-table, .as-post, .as-header-bar, .as-menu-panel, .as-glass)::after {
    --edge-light-size: 190px;
    opacity: 1;
}
