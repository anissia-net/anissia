/*
 * nabi-note 를 사이트 토큰에 맞춘다.
 *
 * 글꼴은 코어가 선언하지 않고 읽기만 하는 값이라 `:root` 한 줄이면 상속으로 닿는다.
 * 색·모양은 코어가 `.nabi` 자리에 직접 선언하므로 상속으로는 이길 수 없다 — 클래스를 셋 겹쳐
 * (0,3,0) 을 만들어야 코어의 밝음/어둠 규칙보다 확실히 위에 선다.
 * 세 자리에 다 건다: 편집기 뿌리, 덮개(미리보기·라이트박스 — body 의 자식이라 상속이 안 닿는다),
 * 홀로 선 보기 뿌리(글만 그리는 자리).
 */
:root {
    --nabi-font: var(--font-sans);
    --nabi-font-serif: var(--font-serif);
    --nabi-font-mono: var(--font-mono);
    --nabi-font-cursive: var(--font-family-cursive);
    --nabi-cursive-adjust: 0.4;
    --nabi-touch-font-size: 1rem;
    /*
     * 사이트 머리줄이 흐름 안으로 들어가 스크롤과 함께 올라가 사라지므로, 붙는 단추 줄을
     * 내려 앉힐 이유가 없다 — 화면 맨 위에 그대로 붙는다.
     * **단위를 뗀 `0` 은 안 된다** — 코어가 이 값을 `calc()` 안에서 길이로 쓰는데, 단위 없는 0 은
     * 거기서 길이가 아니라 숫자라 식 전체가 무효가 되고 `top` 이 `auto` 로 떨어져 sticky 가 죽는다.
     */
    --nabi-sticky-top: 0rem;
}

.nabi.nabi.nabi,
.nabi-scrim.nabi-scrim.nabi-scrim,
.nabi-diff.nabi-diff.nabi-diff,
.nabi-diff-screen.nabi-diff-screen.nabi-diff-screen,
.nabi-merge.nabi-merge.nabi-merge,
.nabi-content.nabi-content.nabi-content {
    /*
     * `--nabi-bg` 는 편집 자리의 바탕이 아니라 **떠 있는 것들**(단추 줄, 판, 알림, 미리보기 상자,
     * 전체화면)의 바탕이다. 투명으로 두면 판과 알림이 글 위로 비쳐 읽을 수 없게 된다.
     * 편집기가 앉은 종이(`.as-post`)와 같은 색을 준다 — 단추 줄이 제 색으로 따로 놀지 않고
     * 한 장 위에 얹힌 것처럼 보인다. 판·알림·전체화면도 같은 종이색이라 어디서나 읽힌다.
     */
    --nabi-bg: var(--as-surface);
    --nabi-soft: var(--as-muted);

    --nabi-fg: var(--as-ink-2);
    --nabi-muted: var(--as-ink-3);
    --nabi-on-accent: var(--as-on-brand);

    --nabi-line: var(--as-line);
    --nabi-accent: var(--as-brand);
    --nabi-danger: var(--as-danger);

    --nabi-radius: var(--radius-ctl);
    --nabi-radius-sm: 0.5rem;
    --nabi-radius-xs: 0.3125rem;
    --nabi-layer-radius: var(--radius-ctl);

    --nabi-shadow: var(--as-shadow-2);

    /*
     * 0.8 부터 자리 표시 글자의 색은 `--nabi-muted` 가 아니라 제 이름을 쓴다 — 코어는 그 이름을
     * **선언하지 않고** 부르기만 하므로(대체값은 알파를 섞은 회색) 여기서 적은 값이 그냥 이긴다.
     * 사이트의 다른 입력칸 자리 표시(`::placeholder`)와 같은 `--as-ink-3` 을 준다 — 편집기 안팎의
     * "아직 안 쓴 자리" 가 같은 회색으로 서야 한 화면으로 읽힌다.
     */
    --nabi-placeholder-color: var(--as-ink-3);

    /*
     * 비어도 한 줄로 주저앉지 않게 하는 하한. 0.8 부터 코어가 `.nabi-editing` 에만 걸고 이 이름을
     * 대체값으로 부르므로, 규칙을 덮지 않고 값 하나만 갈아 끼운다 (코어 기본은 12.5rem).
     * `.nabi-editing` 에만 걸리는 것이 요점이다 — 미리보기·발행된 글은 글 길이가 곧 높이다.
     */
    --nabi-content-min-height: 17.5rem;

    /*
     * 사이트 머리줄(30) 위에 선다 — 머리줄이 아직 안 지나갔을 때 단추 줄이 그 뒤로 묻히면 안 된다.
     */
    --nabi-z-sticky: 31;
    --nabi-outline-z: calc(var(--nabi-z-overlay) + 1);

    /* 전체화면(1.1.2~): 바깥은 사이트 바탕, 종이는 `--nabi-bg` 그대로. */
    --nabi-fullscreen-bg: var(--as-canvas);
}

/* 편집기의 강조 면은 진한 로즈색이므로 밝은 글자를 쓴다. */
html.light .nabi.nabi.nabi,
html.light .nabi-scrim.nabi-scrim.nabi-scrim,
html.light .nabi-diff.nabi-diff.nabi-diff,
html.light .nabi-diff-screen.nabi-diff-screen.nabi-diff-screen,
html.light .nabi-merge.nabi-merge.nabi-merge,
html.light .nabi-content.nabi-content.nabi-content {
    --nabi-on-accent: #fffcf7;
}

/* 어둠에서 흰 종이는 눈을 찌른다 — 읽는 글(`.as-post`)과 같은 한 단 밝은 면을 쓴다. */
html.dark .nabi.nabi.nabi,
html.dark .nabi-diff.nabi-diff.nabi-diff,
html.dark .nabi-diff-screen.nabi-diff-screen.nabi-diff-screen,
html.dark .nabi-merge.nabi-merge.nabi-merge,
html.dark .nabi-content.nabi-content.nabi-content {
    --nabi-bg: var(--as-canvas-2);
}

/* 덮개는 유리로 뜬다 — 뒤가 살짝 비친다. 종이색을 물려받으면 안 되므로 뒤에 적는다. */
.nabi-scrim.nabi-scrim.nabi-scrim {
    --nabi-bg: var(--as-glass-strong);
}

/*
 * 단추 줄은 이제 종이와 같은 색이라 스스로는 끝을 말하지 못한다 — 선 한 줄로 몸과 가른다.
 * 읽는 글의 작성자 줄(`.as-post-head`)과 같은 짜임이다.
 */
.nabi .nabi-toolbar {
    /* border-bottom: 1px solid var(--as-line);*/
}

/* 글자 크기·줄 높이는 토큰이 없다 — 규칙을 직접 덮는다 (코어는 `.nabi-content` 한 겹이다). */
.nabi-content.nabi-content {
    font-size: 0.9375rem;
    line-height: 1.9;
}

/* 각주만 살짝 올린다. sup의 기본 top 보정이 겹쳐 너무 높이 뜨지 않게 한다. */
.nabi-content.nabi-content [data-nabi-fn] {
    top: 0;
    vertical-align: 0.25em;
}

.nabi-content.nabi-content[contenteditable=true],
.nabi-input.nabi-input {
    font-size: 1rem;
}

/*
 * 안쪽 여백은 글이 앉은 **종이**가 두른다 — 코어의 `12px 14px` 를 걷어낸다.
 *
 * 읽는 자리(`NoteView`)와 고쳐 쓰는 자리(`PostEditor`)가 같은 값(`--as-post-pad-*`)을 두르고
 * 글은 그 안에서 가장자리부터 시작한다. 여백을 한 곳에서만 주니 "수정" 을 눌러도 글이 옆으로
 * 밀리지 않고, 좁은 화면에서 여백을 줄일 때도 만질 값이 하나다.
 *
 * `:where()` 로 눕히던 앞선 시도는 죽어 있었다 — 코어의 `.nabi-content` 는 layer 밖 (0,1,0) 이라
 * 특이도 0 은 물론 Tailwind 유틸리티(`px-4`, layer 안이라 언제나 진다)도 이기지 못한다.
 *
 * **편집기 안에만** 건다. 밖(읽는 자리)까지 (0,2,0) 으로 덮으면 종이가 두른 여백(`.as-post-body`,
 * 클래스 한 겹)마저 이겨 버려서 글이 종이 끝에 붙는다 — 밖은 코어와 같은 무게로 두고
 * `style.pcss` 가 뒤에 실린다는 사실만으로 이기게 둔다.
 *
 * 편집기 쪽은 0 이 아니라 **종이와 같은 값**을 여기서 직접 두른다. 종이(`.as-post-editor`)는
 * 편집기가 꽉 차도록 여백을 비워 두므로 — 붙는 단추 줄이 종이 폭을 그대로 덮게 하려면 그래야 한다 —
 * 두를 사람이 쓰는 자리밖에 없다. 읽는 자리와 값이 같으니 "수정" 을 눌러도 글은 그 자리에 그대로 선다.
 */
.nabi .nabi-content {
    padding: var(--as-post-pad-y) var(--as-post-pad-x);
}

.nabi .nabi-content.nabi-footnote-area {
    padding-block-start: 0;
    font-size: 1rem;
}

.as-note-view > .nabi-content {
    padding: 0;
}

.as-note-outline-tools {
    display: flex;
    justify-content: flex-end;
    padding-block-end: 0.25rem;
}

.as-note-outline-tools[hidden],
.as-note-outline-trigger[hidden] {
    display: none;
}

.as-note-outline-trigger {
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--as-line);
    border-radius: var(--radius-ctl);
    color: var(--as-ink-2);
    background: transparent;
    font: 500 0.8125rem/1.25 var(--font-sans);
    cursor: pointer;
}

.as-note-outline-trigger:hover,
.as-note-outline-trigger[aria-expanded=true] {
    color: var(--as-brand);
    background: var(--as-muted);
}

.as-note-outline-trigger:focus-visible {
    outline: 2px solid var(--as-brand);
    outline-offset: 2px;
}

/* 본문 밖으로 옮겨 카드의 잘림과 컨테이너에 영향받지 않고 화면에 고정한다. */
.as-note-outline-floating {
    position: fixed;
    right: calc(1rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    z-index: 30;
    padding: 0;
}

.as-note-outline-floating > .as-note-outline-trigger {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    padding: 0;
    border-radius: 50%;
    background: var(--as-glass-strong);
    box-shadow: var(--as-shadow-2);
    backdrop-filter: blur(0.75rem);
    font-size: 1.5rem;
    touch-action: manipulation;
}

.as-note-outline-floating > .as-note-outline-trigger:hover,
.as-note-outline-floating > .as-note-outline-trigger[aria-expanded=true] {
    color: var(--as-brand);
    background: var(--as-surface);
    border-color: var(--as-brand);
}

.as-note-outline-floating-panel .nabi-outline-item {
    min-height: 2.75rem;
    align-items: center;
}

@media print {
    .as-note-outline-tools {
        display: none;
    }
}

/*
 * 미리보기 본문은 덮개(`.nabi-scrim`) 안, 곧 편집기 **밖**에 선다 — 위 규칙이 안 닿고 호스트의
 * 종이도 없다. 코어 값을 그대로 못박아 둔다.
 * (전체화면은 `.nabi` 안이라 위 규칙이 그대로 닿는다 — 따로 적을 것이 없다.)
 */
.nabi-content.nabi-preview-body {
    padding: 0.75rem 0.875rem;
}

/* 단추 줄은 종이 폭을 꽉 채운다 — 양옆 여백 없이 테두리(1px) 바로 안쪽까지. */
.nabi .nabi-toolbar > .nabi-toolbar-row {
    padding-inline: 0.0625rem;
}

/* 1.6 handles live under body and copy tokens only when selection changes.
 * Read site tokens directly so switching themes also updates an already visible handle. */
.nabi-move-handle.nabi-move-handle {
    color: var(--as-brand);
    background: var(--as-glass-strong);
    border-color: var(--as-line-2);
    box-shadow: var(--as-shadow-2);
    transition: transform 160ms ease, background-color 160ms ease, box-shadow 160ms ease;
}
.nabi-move-handle.nabi-move-handle:is(:hover, :focus-visible) {
    color: var(--as-brand-2);
    background: var(--as-choice-bg);
    border-color: var(--as-brand);
    box-shadow: var(--as-ring), var(--as-shadow-2);
    transform: translateY(-2px);
}
.nabi-move-handle.nabi-move-handle:active { transform: translateY(1px); cursor: grabbing; }
.nabi-move-handle.nabi-move-handle:focus-visible { outline-color: var(--as-brand); }

.nabi-diff .nabi-diff-btn {
    color: var(--as-ink-2);
    border-color: var(--as-line-2);
    transition: color 160ms ease, background-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
}
.nabi-diff .nabi-diff-btn[aria-pressed="false"]:is(:hover, :focus-visible):not(:disabled) {
    color: var(--as-brand);
    background: var(--as-choice-bg);
}
.nabi-diff .nabi-diff-btn[aria-pressed="true"]:not(:disabled) {
    color: var(--nabi-on-accent);
    background: var(--as-brand);
    border-color: var(--as-brand);
    box-shadow: var(--as-shadow-brand);
}
.nabi-diff .nabi-diff-btn [data-nabi-icon="diff-fold"] {
    background-image: none;
    background-color: currentColor;
    mask: var(--nabi-default-icon-diff-fold) center / contain no-repeat;
    transition: transform 180ms ease;
}
.nabi-diff .nabi-diff-btn[aria-pressed="true"] [data-nabi-icon="diff-fold"] {
    background-image: none;
    transform: scaleY(.72);
}
.nabi-diff .nabi-diff-btn:focus-visible { outline: 2px solid var(--as-brand); outline-offset: 2px; }
.nabi-diff .nabi-diff-btn:active:not(:disabled) { transform: translateY(2px); }
.nabi-diff .nabi-diff-gap { border-block: 1px solid var(--as-line-2); }
.nabi-diff.nabi-diff .nabi-diff-gap::before { color: var(--as-brand); font-weight: 700; }

/* The gutter remains visible through >> until hover or keyboard focus. */
.nabi-diff .nabi-diff-merge-action,
.nabi-merge.nabi-merge button.nabi-merge-line-action {
    background: transparent;
    border: 0;
    color: var(--as-ink-2);
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
}
.nabi-diff .nabi-diff-merge-action:is(:hover, :focus-visible):not(:disabled),
.nabi-merge.nabi-merge button.nabi-merge-line-action:is(:hover, :focus-visible):not(:disabled) {
    color: var(--as-brand-2);
    background: var(--as-choice-bg);
    box-shadow: inset 0 0 0 1px var(--as-brand);
}
.nabi-diff .nabi-diff-merge-action svg { transition: translate 160ms ease; }
.nabi-diff .nabi-diff-merge-action:is(:hover, :focus-visible):not(:disabled) svg { translate: 2px 0; }
.nabi-diff .nabi-diff-merge-action:dir(rtl):is(:hover, :focus-visible):not(:disabled) svg { translate: -2px 0; }
html.light .nabi-merge.nabi-merge { --nabi-merge-base: #98602f; --nabi-merge-incoming: #387456; --nabi-merge-conflict: #ac465b; }
html.dark .nabi-merge.nabi-merge { --nabi-merge-base: #e6bb8e; --nabi-merge-incoming: #75d7ac; --nabi-merge-conflict: #f49c9c; }

@media (prefers-reduced-motion: reduce) {
    .nabi-move-handle.nabi-move-handle,
    .nabi-diff .nabi-diff-btn,
    .nabi-diff .nabi-diff-btn [data-nabi-icon],
    .nabi-diff .nabi-diff-merge-action svg,
    .nabi-merge.nabi-merge button.nabi-merge-line-action { transition: none; }
}
