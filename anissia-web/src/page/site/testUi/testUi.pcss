    --as-ink-3: #806e61;
    --as-brand: #a9512e;
    --as-brand-2: #873f22;
    --as-brand-soft: rgba(169, 81, 46, .09);
    --as-danger: #a8302f;
    --as-success: #4a6b45;
    --as-glass-line: rgba(33, 22, 15, .12);
    --as-glass-line-2: rgba(169, 81, 46, .40);
    --as-glass-strong: #ffffff;
    --as-glass-inset: inset 0 0 0 4px #fffbf7, inset 0 0 0 5px rgba(169, 81, 46, .18);
    --as-blur: 0px;
    --as-gradient: linear-gradient(180deg, #bb5f38 0%, #97462a 100%);
    --as-on-brand: #ffffff;
    --as-shadow-1: 0 1px 0 rgba(33, 22, 15, .05), 0 16px 34px -26px rgba(33, 22, 15, .40);
    --as-shadow-2: 0 1px 0 rgba(33, 22, 15, .05), 0 22px 44px -30px rgba(33, 22, 15, .45);
    --as-shadow-3: 0 2px 0 rgba(33, 22, 15, .05), 0 30px 60px -30px rgba(33, 22, 15, .50);
    --as-shadow-brand: inset 0 1px 0 rgba(255, 255, 255, .2), 0 8px 18px -10px rgba(151, 70, 42, .55);
    --as-ring: 0 0 0 3px rgba(169, 81, 46, .16);
    --as-wordmark-gradient: linear-gradient(120deg, #21160f 0%, #21160f 40%, #a9512e 100%);

    .as-page-title { font-weight: 900; letter-spacing: -.045em }
    .as-section-title { font-weight: 800 }

    body {
        background:
            radial-gradient(70rem 40rem at 50% -20%, rgba(255, 255, 255, .9), transparent 70%),
            radial-gradient(50rem 36rem at 100% 100%, rgba(210, 150, 110, .12), transparent 64%),
            linear-gradient(180deg, #f7f2ec 0%, #eee6dc 100%);
        background-attachment: fixed;
