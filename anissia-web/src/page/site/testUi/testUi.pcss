/* M5. Swiss Mono — 흑백 + 시그널 레드 */
html.light[data-ui="swiss"] {
    --as-canvas: #f6f6f5;
    --as-canvas-2: #ececea;
    --as-surface: #ffffff;
    --as-surface-2: #ffffff;
    --as-muted: #f2f2f1;
    --as-line: rgba(0, 0, 0, .10);
    --as-line-2: rgba(0, 0, 0, .22);
    --as-ink: #111111;
    --as-ink-2: #3b3b3b;
    --as-ink-3: #6b6b6b;
    --as-brand: #d0342c;
    --as-brand-2: #a8261f;
    --as-brand-soft: rgba(208, 52, 44, .07);
    --as-danger: #d0342c;
    --as-success: #1f7a52;
    --as-glass-line: rgba(0, 0, 0, .12);
    --as-glass-line-2: rgba(0, 0, 0, .60);
    --as-glass-strong: #ffffff;
    --as-glass-inset: inset 0 0 0 0 transparent;
    --as-blur: 0px;
    --as-gradient: linear-gradient(180deg, #111111 0%, #111111 100%);
    --as-on-brand: #ffffff;
    --as-shadow-1: 0 0 0 0 transparent;
    --as-shadow-2: 0 0 0 0 transparent;
    --as-shadow-3: 0 12px 28px -18px rgba(0, 0, 0, .25);
    --as-shadow-brand: 0 0 0 0 transparent;
    --as-ring: 0 0 0 3px rgba(208, 52, 44, .16);
    --as-wordmark-gradient: linear-gradient(120deg, #111111 0%, #111111 100%);

    .as-header-bar { box-shadow: none; border-color: var(--as-line-2) }
    .as-card:hover { transform: none; border-color: var(--as-ink) }
    .as-btn-primary:hover { background: var(--as-brand); filter: none }
    .as-section-title { box-shadow: inset 0 -3px 0 var(--as-brand) }
    .rank-no.is-top { background: var(--as-brand) }

    body {
        background:
            linear-gradient(rgba(0, 0, 0, .04) 1px, transparent 1px) 0 0 / 32px 32px,
            linear-gradient(90deg, rgba(0, 0, 0, .04) 1px, transparent 1px) 0 0 / 32px 32px,
            linear-gradient(180deg, #f8f8f7 0%, #f0f0ee 100%);
        background-attachment: fixed;
    }
}

/* 실제 어드민(admin/layout.vue)과 같은 탭 — 그쪽 스타일은 어드민 청크에서만 실린다 */
.as-segment.admin-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  > a {
    @apply flex flex-col items-center justify-center gap-2 h-12 sm:h-[5.75rem] p-0 text-xs font-semibold;
    img {
      @apply w-6 sm:w-8 transition-all duration-300;
      filter: grayscale(100%);
      opacity: .45;
    }
    span { @apply hidden sm:inline leading-none }
    &:hover img { opacity: .8; filter: grayscale(60%) }
    &.is-on {
      color: var(--as-brand);
      img { opacity: 1; filter: none }
    }
  }
}
