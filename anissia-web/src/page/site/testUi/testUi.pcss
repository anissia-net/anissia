    --as-on-brand: #ffffff;
    --as-shadow-1: 0 1px 0 rgba(21, 26, 21, .05), 0 14px 30px -24px rgba(21, 26, 21, .35);
    --as-shadow-2: 0 1px 0 rgba(21, 26, 21, .05), 0 20px 40px -28px rgba(21, 26, 21, .40);
    --as-shadow-3: 0 2px 0 rgba(21, 26, 21, .05), 0 28px 56px -28px rgba(21, 26, 21, .45);
    --as-shadow-brand: inset 0 1px 0 rgba(255, 255, 255, .18), 0 8px 18px -10px rgba(67, 94, 75, .50);
    --as-ring: 0 0 0 3px rgba(76, 106, 85, .16);
    --as-wordmark-gradient: linear-gradient(120deg, #151a15 0%, #151a15 40%, #4c6a55 100%);

    body {
