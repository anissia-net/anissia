            linear-gradient(180deg, #f4f5f0 0%, #eaece5 100%);
        background-attachment: fixed;
    }
}

/* M4. Terracotta Clay */
html.light[data-ui="terracotta"] {
    --as-canvas: #f5efe8;
    --as-canvas-2: #ece3d8;
    --as-surface: #fffbf7;
    --as-surface-2: #ffffff;
    --as-muted: rgba(33, 22, 15, .045);
