/* ═════════ 매트 · 플랫 ═════════ */

/* M1. Champagne Noir — 아이보리, 먹색 단추, 금빛 액자선 */
html.light[data-ui="champagne"] {
    --as-canvas: #f6f2ea;
    --as-canvas-2: #ede7db;
    --as-surface: #fffdf8;
    --as-surface-2: #ffffff;
    --as-muted: rgba(40, 30, 15, .045);
    --as-line: rgba(40, 30, 15, .11);
    --as-line-2: rgba(40, 30, 15, .20);
    --as-ink: #17140f;
    --as-ink-2: #443d33;
    --as-ink-3: #776e60;
    --as-brand: #8f6a2a;
    --as-brand-2: #6f511d;
    --as-brand-soft: rgba(143, 106, 42, .09);
    --as-danger: #a8372d;
    --as-success: #3d6b4a;
    --as-glass-line: rgba(40, 30, 15, .13);
    --as-glass-line-2: rgba(143, 106, 42, .45);
    --as-glass-strong: #ffffff;
    --as-glass-inset: inset 0 0 0 4px #fffdf8, inset 0 0 0 5px rgba(143, 106, 42, .30);
    --as-blur: 0px;
    --as-gradient: linear-gradient(180deg, #2b251c 0%, #14110c 100%);
    --as-on-brand: #ecdcb3;
    --as-shadow-1: 0 1px 0 rgba(40, 30, 15, .05), 0 16px 34px -26px rgba(40, 30, 15, .40);
    --as-shadow-2: 0 1px 0 rgba(40, 30, 15, .05), 0 22px 44px -30px rgba(40, 30, 15, .45);
    --as-shadow-3: 0 2px 0 rgba(40, 30, 15, .05), 0 30px 60px -30px rgba(40, 30, 15, .50);
    --as-shadow-brand: inset 0 1px 0 rgba(236, 220, 179, .18), 0 8px 18px -10px rgba(20, 17, 12, .50);
    --as-ring: 0 0 0 3px rgba(143, 106, 42, .18);
    --as-wordmark-gradient: linear-gradient(120deg, #17140f 0%, #17140f 40%, #a88242 100%);

    .as-section-title { box-shadow: inset 0 -2px 0 #a88242 }

    body {
        background:
            radial-gradient(70rem 40rem at 50% -20%, rgba(255, 255, 255, .95), transparent 70%),
            radial-gradient(50rem 36rem at 100% 100%, rgba(200, 175, 125, .12), transparent 64%),
            linear-gradient(180deg, #f8f5ee 0%, #f0ebe0 100%);
        background-attachment: fixed;
    }
}

/* M2. Bordeaux Linen */
html.light[data-ui="bordeaux"] {
    --as-canvas: #f3efe9;
    --as-canvas-2: #e9e3da;
    --as-surface: #fffcf8;
    --as-surface-2: #ffffff;
    --as-muted: rgba(29, 18, 20, .045);
    --as-line: rgba(29, 18, 20, .11);
    --as-line-2: rgba(29, 18, 20, .20);
    --as-ink: #1d1214;
    --as-ink-2: #4a3a3c;
    --as-ink-3: #7a6a6b;
    --as-brand: #7d2438;
    --as-brand-2: #611a2b;
    --as-brand-soft: rgba(125, 36, 56, .08);
    --as-danger: #a8302f;
    --as-success: #3d6b4a;
    --as-glass-line: rgba(29, 18, 20, .13);
    --as-glass-line-2: rgba(125, 36, 56, .40);
    --as-glass-strong: #ffffff;
    --as-glass-inset: inset 0 0 0 4px #fffcf8, inset 0 0 0 5px rgba(125, 36, 56, .18);
    --as-blur: 0px;
    --as-gradient: linear-gradient(180deg, #8f2c43 0%, #6b1d2e 100%);
    --as-on-brand: #ffffff;
    --as-shadow-1: 0 1px 0 rgba(29, 18, 20, .05), 0 16px 34px -26px rgba(29, 18, 20, .40);
    --as-shadow-2: 0 1px 0 rgba(29, 18, 20, .05), 0 22px 44px -30px rgba(29, 18, 20, .45);
    --as-shadow-3: 0 2px 0 rgba(29, 18, 20, .05), 0 30px 60px -30px rgba(29, 18, 20, .50);
    --as-shadow-brand: inset 0 1px 0 rgba(255, 255, 255, .18), 0 8px 18px -10px rgba(107, 29, 46, .55);
    --as-ring: 0 0 0 3px rgba(125, 36, 56, .16);
    --as-wordmark-gradient: linear-gradient(120deg, #1d1214 0%, #1d1214 40%, #7d2438 100%);

    body {
        background:
            repeating-linear-gradient(0deg, rgba(60, 35, 30, .026) 0 1px, transparent 1px 3px),
            repeating-linear-gradient(90deg, rgba(60, 35, 30, .02) 0 1px, transparent 1px 4px),
            radial-gradient(70rem 40rem at 50% -20%, rgba(255, 255, 255, .9), transparent 70%),
            linear-gradient(180deg, #f5f1eb 0%, #ece6dd 100%);
        background-attachment: fixed;
    }
}

/* M3. Sage Paper */
html.light[data-ui="sage"] {
    --as-canvas: #f2f3ee;
    --as-canvas-2: #e7e9e1;
    --as-surface: #fdfdfa;
